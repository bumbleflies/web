---
import Layout from '../components/Layout.astro';
import Nav from '../components/Nav.astro';
import CaseStudiesList from '../components/CaseStudiesList.astro';
import Footer from '../components/Footer.astro';
import LangToggle from '../components/LangToggle.astro';
---

<Layout
  title="Case Studies - bumbleflies"
  description="Unsere Case Studies: Von LeagueSphere über DialograumGeld bis Siemens. Echte Projekte, echte Ergebnisse. Conversation to Code in Action."
  canonical="https://bumbleflies.de/case-studies"
  lang="DE"
  dePath="/case-studies"
>
  <div slot="nav">
    <Nav lang="DE" />
  </div>
    <section class="a-case-studies-hero">
      <div class="bf-container">
        <h1 class="a-case-studies-hero__heading">Track Record</h1>
        <p class="a-case-studies-hero__subheading">
          Echte Ergebnisse von echten Kunden. Von Konversation zu Code — und auch wirklich nutzbar.
        </p>
      </div>
    </section>

    <CaseStudiesList />

    <section class="a-case-studies-cta">
      <div class="bf-container">
        <h2>Bereit für Ihre Transformation?</h2>
        <a href="mailto:info@bumbleflies.de" class="bf-cta">Erstes Gespräch vereinbaren</a>
      </div>
    </section>

  <div slot="footer">
    <Footer />
  </div>
</Layout>

<style>
  .a-case-studies-hero {
    padding: var(--space-4xl) 0;
    background: var(--paper);
  }

  .a-case-studies-hero__heading {
    font-family: var(--font-display);
    font-size: var(--text-6xl);
    margin: 0 0 1rem 0;
    color: var(--ink);
  }

  .a-case-studies-hero__subheading {
    font-size: var(--text-lg);
    color: var(--ink-soft);
    max-width: 600px;
    margin: 0;
  }

  .a-case-studies-cta {
    padding: var(--space-4xl) 0;
    text-align: center;
    background: var(--paper); border-top: 1px solid var(--rule);
  }

  .a-case-studies-cta h2 {
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    margin-bottom: 2rem;
    color: var(--ink);
  }

  @media (max-width: 768px) {
    .a-case-studies-hero {
      padding: var(--space-2xl) 0;
    }

    .a-case-studies-hero__heading {
      font-size: var(--text-2xl);
    }

    .a-case-studies-hero__subheading {
      font-size: 1rem;
    }

    .a-case-studies-cta h2 {
      font-size: var(--text-xl);
    }
  }
</style>

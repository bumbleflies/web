---
import { getCollection, render } from 'astro:content';
import Layout from '../../components/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import LangToggle from '../../components/LangToggle.astro';

export async function getStaticPaths() {
  const caseStudies = await getCollection('case-studies', ({ data }) => data.published);
  return caseStudies.map(study => ({
    params: { slug: study.id },
    props: { study },
  }));
}

const { study } = Astro.props;
const { Content } = await render(study);
---

<Layout title={study.data.title}>
  <Nav slot="nav">
    <LangToggle slot="lang" />
  </Nav>
  <article class="a-case-study-detail">
    <div class="a-case-study-detail__inner">
      <a href="/case-studies" class="a-case-study-detail__back">← Alle Fallstudien</a>

      <header class="a-case-study-detail__header">
        <h1 class="a-case-study-detail__title">{study.data.title}</h1>
        <p class="a-case-study-detail__company">{study.data.company}</p>
        <span class="a-case-study-detail__service">{study.data.service}</span>
        {study.data.duration && (
          <p class="a-case-study-detail__duration">{study.data.duration}</p>
        )}
      </header>

      <div class="a-case-study-detail__content">
        <Content />
      </div>

      <aside class="a-case-study-detail__quote">
        <blockquote>"{study.data.quote}"</blockquote>
      </aside>

    </div>
      <div class="a-case-study-detail__cta">
        <a href="mailto:info@bumbleflies.de" class="bf-cta">Erstes Gespräch buchen</a>
      </div>
    </article>
  <Footer slot="footer" />
</Layout>

<style>
  .a-case-study-detail {
    padding: var(--space-4xl) 0;
  }

  .a-case-study-detail__inner {
    max-width: 680px;
    margin: 0 auto;
    padding: 0 var(--space-lg);
  }

  .a-case-study-detail__back {
    display: inline-block;
    margin-bottom: var(--space-xl);
    color: var(--accent);
    text-decoration: none;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: var(--ls-widest);
    transition: opacity var(--duration-fast) var(--easing-default);
  }

  .a-case-study-detail__back:hover {
    opacity: 0.7;
  }

  .a-case-study-detail__header {
    margin-bottom: var(--space-3xl);
    padding-bottom: var(--space-xl);
    border-bottom: 1px solid var(--rule);
  }

  .a-case-study-detail__title {
    font-family: var(--font-display);
    font-size: var(--text-6xl);
    line-height: var(--lh-tight);
    margin: 0 0 var(--space-md) 0;
    color: var(--ink);
  }

  .a-case-study-detail__company {
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--text-2xl);
    color: var(--ink-soft);
    margin: 0 0 var(--space-sm) 0;
  }

  .a-case-study-detail__service {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: var(--ls-widest);
    padding: var(--space-xs) var(--space-sm);
    background: var(--accent);
    color: white;
    margin-bottom: var(--space-md);
  }

  .a-case-study-detail__duration {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--ink-soft);
    margin: 0;
  }

  .a-case-study-detail__content {
    font-family: var(--font-sans);
    font-size: var(--text-lg);
    line-height: var(--lh-body);
    margin-bottom: var(--space-3xl);
    color: var(--ink);
    max-width: 680px;
  }

  .a-case-study-detail__content :global(h2) {
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    line-height: var(--lh-snug);
    margin-top: var(--space-2xl);
    margin-bottom: var(--space-md);
    color: var(--ink);
  }

  .a-case-study-detail__content :global(p) {
    margin-bottom: var(--space-lg);
  }

  .a-case-study-detail__content :global(strong) {
    color: var(--ink);
    font-weight: 600;
  }

  .a-case-study-detail__content :global(ul),
  .a-case-study-detail__content :global(ol) {
    margin: var(--space-lg) 0;
    padding-left: var(--space-xl);
  }

  .a-case-study-detail__content :global(li) {
    margin-bottom: var(--space-sm);
  }

  .a-case-study-detail__quote {
    padding: var(--space-2xl);
    background: var(--paper);
    border-left: 4px solid var(--accent);
    margin: var(--space-3xl) 0;
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--text-2xl);
    line-height: var(--lh-loose);
    color: var(--ink);
  }

  @media (max-width: 768px) {
    .a-case-study-detail {
      padding: var(--space-2xl) 0;
    }

    .a-case-study-detail__title {
      font-size: var(--text-4xl);
    }

    .a-case-study-detail__company {
      font-size: var(--text-xl);
    }

    .a-case-study-detail__content {
      font-size: var(--text-base);
    }

    .a-case-study-detail__quote {
      padding: var(--space-xl);
      font-size: var(--text-xl);
    }
  }
    border-left: 3px solid var(--accent);
    margin: var(--space-xl) 0;
    font-style: italic;
    font-size: 1.125rem;
    line-height: 1.6;
    color: #333;
    font-family: var(--font-sans);
  }

  .a-case-study-detail__quote blockquote {
    margin: 0;
  }

  .a-case-study-detail__cta {
    text-align: center;
    margin: var(--space-xl) 0;
  }

  @media (max-width: 768px) {
    .a-case-study-detail {
      padding: var(--space-lg) 0;
    }

    .a-case-study-detail__title {
      font-size: 1.875rem;
    }

    .a-case-study-detail__quote {
      font-size: 1rem;
      padding: var(--space-md);
    }
  }
</style>

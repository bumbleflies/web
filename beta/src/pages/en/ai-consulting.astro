---
import Layout from '../../components/Layout.astro';
import Nav from '../../components/Nav.astro';
import Quote from '../../components/Quote.astro';
import CTAStrip from '../../components/CTAStrip.astro';
import PipelineFlow from '../../components/PipelineFlow.astro';
import Faq from '../../components/Faq.astro';
import Footer from '../../components/Footer.astro';
import { getCollection } from 'astro:content';

const enPages = await getCollection('pages', ({ id }) => id === 'en/ai-consulting');

if (!enPages[0]) {
  throw new Error('EN AI Consulting content not found in collection');
}

const content = enPages[0].data;

const lang: 'DE' | 'EN' = 'EN';

const pageTitle = 'Agentic Software Development & AI Consulting | bumbleflies';
const pageDescription = 'We build your software with autonomous AI agents and human-in-the-loop — from ticket to release. AI consulting that delivers: from Conversation to Code.';

const faqItems = [
  {
    q: 'Can AI implement feature requests on its own?',
    a: 'Yes. A GitHub issue written in plain language becomes a finished pull request via autonomous agents — test-first (TDD), with a review-and-test loop until approval and automerge.',
  },
  {
    q: 'How does a human stay in control (human-in-the-loop)?',
    a: 'A human decides what gets built. Agents handle the implementation; a review-and-test bot iterates until everything is green. You set the direction, a human stays at the wheel.',
  },
  {
    q: 'What does "From Conversation to Code" mean?',
    a: 'From the first conversation through strategy to running software: we understand, decide, pilot and scale — real software, not slideware.',
  },
  {
    q: 'How fast is a working prototype?',
    a: 'In 4–6 weeks we build a functional prototype. No mockups, real software — in your context.',
  },
  {
    q: 'Which tools do you use?',
    a: 'GitHub for issues and pull requests, our own orchestration framework and opencode for implementation, test-first (TDD), with an automated review-and-test loop.',
  },
];

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: 'AI Consulting & Agentic Software Development',
  name: 'AI Consulting & Agentic Software Development',
  description: pageDescription,
  provider: { '@type': 'Organization', name: 'bumbleflies', url: 'https://bumbleflies.de' },
  areaServed: ['Munich', 'Germany', 'DACH'],
  url: 'https://bumbleflies.de/en/ai-consulting/',
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonical="https://bumbleflies.de/en/ai-consulting"
  lang={lang}
  dePath="/ai-consulting"
  enPath="/en/ai-consulting"
  jsonLd={[serviceSchema, faqSchema]}
>
  <div slot="nav">
    <Nav lang={lang} />
  </div>

  <section class="a-ai-hero">
    <div class="bf-container">
      <p class="a-ai-hero__label">AI Consulting · Agentic Development</p>
      <h1 class="a-ai-hero__heading">{content.heading}</h1>
      <p class="a-ai-hero__subheading">{content.subheading}</p>
    </div>
  </section>

  <section class="a-ai-steps bf-section">
    <div class="bf-container">
      <h2 class="a-ai-steps__heading">Our path: Conversation to Code</h2>
      <div class="a-ai-steps__list">
        {content.steps?.map((step) => (
          <div class="a-ai-step-row">
            <span class="a-ai-step-row__number">{step.number}</span>
            <h3 class="a-ai-step-row__title">{step.title}</h3>
            <p class="a-ai-step-row__desc">{step.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="a-ai-services bf-section">
    <div class="bf-container">
      <h2 class="a-ai-services__heading">What we do for you</h2>
      <div class="a-ai-services__grid">
        <div class="a-ai-service-card">
          <h3>AI Strategy & Roadmap</h3>
          <p>Where are you? Where do you want to go? We develop a tailored AI strategy with clear milestones.</p>
        </div>
        <div class="a-ai-service-card">
          <h3>Technology Assessment</h3>
          <p>Which AI technologies fit your stack? LLMs, embeddings, agents — we evaluate what actually works.</p>
        </div>
        <div class="a-ai-service-card">
          <h3>Make-vs-Buy Decisions</h3>
          <p>Save expensive custom development for standard problems. We honestly tell you whether to buy, rent or build yourself.</p>
        </div>
        <div class="a-ai-service-card">
          <h3>Pilot Support & Coaching</h3>
          <p>From first prototype to production readiness. We support your team so the pilot doesn't end up in a drawer.</p>
        </div>
      </div>
    </div>
  </section>

  <PipelineFlow lang={lang} />

  <Faq heading="Frequently asked questions" items={faqItems} />

  <section class="a-ai-quote bf-section">
    <div class="bf-container">
      <Quote
        text={content.quote ?? ''}
        cite={content.quoteCite ?? ''}
        lang={lang}
      />
    </div>
  </section>

  <CTAStrip
    heading={content.ctaHeading}
    headingEm={content.ctaHeading_em}
    body={content.ctaBody}
    ctaText={content.ctaText}
    lang={lang}
  />

  <div slot="footer">
    <Footer />
  </div>
</Layout>

<style>
  .a-ai-hero {
    padding: 4rem 0;
    background: var(--paper);
  }
  .a-ai-hero__label {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: var(--ls-widest);
    color: var(--accent);
    margin: 0 0 1rem;
  }
  .a-ai-hero__heading {
    font-family: var(--font-display);
    font-size: 3rem;
    margin: 0 0 1rem;
    color: var(--ink);
    max-width: 800px;
  }
  .a-ai-hero__subheading {
    font-size: 1.25rem;
    color: var(--ink-soft);
    max-width: 650px;
    margin: 0;
  }
  .a-ai-steps {
    padding: 4rem 0;
    background: var(--bg);
  }
  .a-ai-steps__heading {
    font-family: var(--font-display);
    font-size: 2rem;
    margin: 0 0 2.5rem;
    color: var(--ink);
  }
  .a-ai-steps__list {
    border-top: 1px solid var(--rule);
  }
  .a-ai-step-row {
    display: grid;
    grid-template-columns: 96px 1.2fr 2fr;
    gap: 2rem;
    padding: 2rem 0;
    border-bottom: 1px solid var(--rule);
    align-items: baseline;
  }
  .a-ai-step-row__number {
    font-family: var(--font-display);
    font-size: 2.75rem;
    line-height: 1;
    color: var(--accent);
    letter-spacing: -0.02em;
  }
  .a-ai-step-row__title {
    font-family: var(--font-display);
    font-size: 1.6rem;
    margin: 0;
    color: var(--ink);
  }
  .a-ai-step-row__desc {
    font-size: 1rem;
    line-height: 1.6;
    color: var(--ink-soft);
    margin: 0;
  }
  .a-ai-services {
    padding: 4rem 0;
    background: var(--paper);
  }
  .a-ai-services__heading {
    font-family: var(--font-display);
    font-size: 2rem;
    margin: 0 0 2.5rem;
    color: var(--ink);
  }
  .a-ai-services__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
  }
  .a-ai-service-card {
    padding: 1.5rem;
    border: 1px solid var(--rule);
    border-radius: 8px;
  }
  .a-ai-service-card h3 {
    font-family: var(--font-display);
    font-size: 1.2rem;
    margin: 0 0 0.75rem;
    color: var(--ink);
  }
  .a-ai-service-card p {
    font-size: 0.95rem;
    line-height: 1.55;
    color: var(--ink-soft);
    margin: 0;
  }
  .a-ai-quote {
    padding: 4rem 0;
    background: var(--bg);
    text-align: center;
  }
  @media (max-width: 768px) {
    .a-ai-hero { padding: 2.5rem 0; }
    .a-ai-hero__heading { font-size: 2rem; }
    .a-ai-hero__subheading { font-size: 1rem; }
    .a-ai-steps { padding: 2.5rem 0; }
    .a-ai-steps__heading { font-size: 1.5rem; }
    .a-ai-step-row {
      grid-template-columns: 64px 1fr;
      gap: 0.5rem 1.25rem;
      padding: 1.5rem 0;
    }
    .a-ai-step-row__number { font-size: 2rem; }
    .a-ai-step-row__title { font-size: 1.35rem; grid-column: 2; }
    .a-ai-step-row__desc { grid-column: 2; }
    .a-ai-services { padding: 2.5rem 0; }
    .a-ai-services__grid { grid-template-columns: 1fr; gap: 1.5rem; }
    .a-ai-services__heading { font-size: 1.5rem; }
    .a-ai-quote { padding: 2.5rem 0; }
  }
  @media (max-width: 480px) {
    .a-ai-hero { padding: 1.5rem 0; }
    .a-ai-hero__heading { font-size: 1.5rem; }
    .a-ai-steps { padding: 1.5rem 0; }
    .a-ai-services { padding: 1.5rem 0; }
    .a-ai-quote { padding: 1.5rem 0; }
  }
</style>

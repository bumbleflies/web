---
import Layout from '../../components/Layout.astro';
import Nav from '../../components/Nav.astro';
import BlogList from '../../components/BlogList.astro';
import Footer from '../../components/Footer.astro';

// When the preview key is set at build time, pass it to BlogList so it renders
// all posts (including drafts). Otherwise BlogList only shows published posts.
const showDrafts = !!import.meta.env.PUBLIC_PREVIEW_KEY;

const lang: 'DE' | 'EN' = 'EN';
---

<Layout
  title="Field Notes: What Broke, What We Learned, What We Changed | bumbleflies"
  description="An article series about a real AI agent operating system in production: autonomous Claude Code bots, n8n event automation, a skill marketplace for company knowledge. And the scars: what broke, what we learned, what we changed."
  canonical="https://bumbleflies.de/en/blog"
  lang={lang}
  dePath="/blog"
  enPath="/en/blog"
>
  <div slot="nav">
    <Nav lang={lang} />
  </div>

  <section class="a-blog-hero">
    <div class="bf-container">
      <span class="a-blog-hero__kicker">Field Notes · AI Series</span>
      <h1 class="a-blog-hero__heading">What broke, what we learned, what we changed</h1>
      <p class="a-blog-hero__subheading">
        No hype, no proof-of-concept that disappears in a drawer. This series documents a complete AI agent operating system in production at JUNE, a German legal-tech company, written by Chris, who built it there and is also part of our team, not as a bumbleflies client project. Autonomous bots that open pull requests while the team sleeps. And the scars: a night that burned several hundred euros in tokens, a read email that cost two days, an endless self-restart loop. Every protective measure here is a dated incident that became a rule.
      </p>
    </div>
  </section>

  <BlogList showDrafts={showDrafts} lang="EN" />

  <section class="a-blog-cta">
    <div class="bf-container">
      <h2>You have the romantic notion that we've got a treasure over there?</h2>
      <p>We do. Send us two sentences about your topic. We'll reply with an honest assessment.</p>
      <a href="mailto:info@bumbleflies.de" class="bf-cta">Book a first conversation</a>
    </div>
  </section>

  <Footer slot="footer" />
</Layout>

<style>
  .a-blog-hero {
    padding: var(--space-4xl) 0 var(--space-2xl);
    background: var(--paper);
  }

  .a-blog-hero__kicker {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: var(--ls-widest);
    color: var(--accent);
    margin-bottom: var(--space-md);
  }

  .a-blog-hero__heading {
    font-family: var(--font-display);
    font-size: var(--text-6xl);
    line-height: var(--lh-tight);
    margin: 0 0 1rem 0;
    color: var(--ink);
    max-width: 900px;
  }

  .a-blog-hero__subheading {
    font-size: var(--text-lg);
    color: var(--ink-soft);
    max-width: 720px;
    margin: 0;
    line-height: var(--lh-body);
  }

  .a-blog-cta {
    padding: var(--space-4xl) 0;
    text-align: center;
    background: var(--paper);
    border-top: 1px solid var(--rule);
  }

  .a-blog-cta h2 {
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    margin: 0 auto 1rem;
    max-width: 720px;
    color: var(--ink);
  }

  .a-blog-cta p {
    color: var(--ink-soft);
    max-width: 560px;
    margin: 0 auto 2rem;
  }

  @media (max-width: 768px) {
    .a-blog-hero {
      padding: var(--space-2xl) 0 var(--space-xl);
    }

    .a-blog-hero__heading {
      font-size: var(--text-3xl);
    }

    .a-blog-hero__subheading {
      font-size: 1rem;
    }

    .a-blog-cta h2 {
      font-size: var(--text-xl);
    }
  }
</style>

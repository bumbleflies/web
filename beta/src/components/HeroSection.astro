---
type BgColor = 'coral' | 'blue' | 'teal';

interface Props {
  headline: string;
  subheading: string;
  ctaText: string;
  ctaHref: string;
  bgColor?: BgColor;
}

const { headline, subheading, ctaText, ctaHref, bgColor = 'coral' } = Astro.props;

const bgGradients = {
  coral: 'linear-gradient(135deg, #f5e6d3 0%, #ffb8a1 100%)',
  blue: 'linear-gradient(135deg, #d9e4f7 0%, #6d9eeb 100%)',
  teal: 'linear-gradient(135deg, #c8e6e0 0%, #4db8aa 100%)',
};
---

<section class="bf-hero-section" style={`background: ${bgGradients[bgColor]}`}>
  <div class="bf-container">
    <div class="bf-hero-section__content">
      <h1 class="bf-hero-section__headline">{headline}</h1>
      <p class="bf-hero-section__subheading">{subheading}</p>
      <a href={ctaHref} class="bf-cta">{ctaText}</a>
    </div>
  </div>
</section>

<style>
  .bf-hero-section {
    padding: var(--space-5xl) 0;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 400px;
  }

  .bf-hero-section__content {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: var(--space-2xl);
    max-width: 720px;
  }

  .bf-hero-section__headline {
    font-family: var(--font-display);
    font-size: var(--text-6xl);
    line-height: var(--lh-snug);
    letter-spacing: var(--ls-tight);
    margin: 0;
    font-weight: 400;
    color: var(--ink);
  }

  .bf-hero-section__subheading {
    font-family: var(--font-sans);
    font-size: var(--text-xl);
    line-height: var(--lh-loose);
    color: var(--ink-soft);
    margin: 0;
    max-width: 600px;
  }

  @media (max-width: 768px) {
    .bf-hero-section {
      padding: var(--space-3xl) 0;
      min-height: 300px;
    }

    .bf-hero-section__headline {
      font-size: var(--text-4xl);
    }

    .bf-hero-section__subheading {
      font-size: var(--text-lg);
    }
  }

  @media (max-width: 480px) {
    .bf-hero-section {
      padding: var(--space-2xl) 0;
      min-height: 250px;
    }

    .bf-hero-section__headline {
      font-size: var(--text-2xl);
    }

    .bf-hero-section__subheading {
      font-size: var(--text-base);
    }

    .bf-hero-section__content {
      gap: var(--space-xl);
    }
  }
</style>

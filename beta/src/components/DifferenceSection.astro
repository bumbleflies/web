---
interface Props {
  lang?: 'DE' | 'EN';
}

const { lang = 'DE' } = Astro.props;

const content = lang === 'DE'
  ? {
      eyebrow: 'Der Unterschied',
      heading: 'Andere geben das Problem weiter. Wir bleiben dran.',
      badTitle: 'Die übliche Staffelübergabe',
      badItems: [
        { name: 'Workshop-Agentur', note: 'Definiert das Problem' },
        { name: 'Unternehmensberatung', note: 'Kontext geht verloren' },
        { name: 'Software-Dienstleister', note: 'Ihr erklärt alles neu' },
        { name: 'Change-Management', note: 'Niemand besitzt das Ergebnis' },
      ],
      goodTitle: 'bumbleflies: ein Team, ganze Strecke',
      goodItems: [
        { name: 'Reden', num: '01' },
        { name: 'Entscheiden', num: '02' },
        { name: 'Bauen', num: '03' },
        { name: 'Begleiten', num: '04' },
      ],
      goodNote: 'Ein Team versteht alle vier Phasen — Wissen aus dem Workshop fließt direkt in die Software, Adoption ist von Tag 1 mitgedacht.',
      pullquote: '„Weil echter Wandel meist genau in den Lücken dazwischen scheitert.“',
    }
  : {
      eyebrow: 'The difference',
      heading: 'Others hand the problem off. We stay with it.',
      badTitle: 'The usual relay',
      badItems: [
        { name: 'Workshop agency', note: 'Defines the problem' },
        { name: 'Consultancy', note: 'Context gets lost' },
        { name: 'Software vendor', note: 'You explain everything again' },
        { name: 'Change management', note: 'Nobody owns the outcome' },
      ],
      goodTitle: 'bumbleflies: one team, whole journey',
      goodItems: [
        { name: 'Talk', num: '01' },
        { name: 'Decide', num: '02' },
        { name: 'Build', num: '03' },
        { name: 'Embed', num: '04' },
      ],
      goodNote: 'One team understands all four phases — workshop insight flows directly into software, adoption considered from day one.',
      pullquote: '"Because real change usually fails exactly in the gaps in between."',
    };
---

<section class="a-difference">
  <div class="bf-container">
    <span class="bf-eyebrow">{content.eyebrow}</span>
    <h2 class="a-difference__heading">{content.heading}</h2>

    <div class="a-difference__grid">
      <div class="a-difference__col a-difference__col--bad">
        <h3 class="a-difference__col-title">{content.badTitle}</h3>
        <ul class="a-difference__relay">
          {content.badItems.map((item) => (
            <li>
              <span>{item.name}</span>
              <small>{item.note}</small>
            </li>
          ))}
        </ul>
      </div>
      <div class="a-difference__col a-difference__col--good">
        <h3 class="a-difference__col-title">{content.goodTitle}</h3>
        <ul class="a-difference__together">
          {content.goodItems.map((item) => (
            <li>
              <span>{item.name}</span>
              <b>{item.num}</b>
            </li>
          ))}
        </ul>
        <p class="a-difference__note">{content.goodNote}</p>
      </div>
    </div>

    <p class="a-difference__pullquote">{content.pullquote}</p>
  </div>
</section>

<style>
  .a-difference {
    border-top: 1px solid var(--rule);
    padding: var(--space-4xl) 0;
  }

  .a-difference__heading {
    font-family: var(--font-display);
    font-size: var(--text-5xl);
    line-height: var(--lh-tight);
    letter-spacing: var(--ls-tight);
    max-width: 20ch;
    margin: var(--space-md) 0 var(--space-3xl);
    font-weight: 400;
  }

  .a-difference__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-2xl);
  }

  .a-difference__col {
    border: 1px solid var(--rule);
    border-radius: var(--radius-sm);
    padding: var(--space-2xl);
  }

  .a-difference__col--good {
    background: var(--accent-soft, rgba(166, 124, 77, 0.08));
  }

  .a-difference__col-title {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    text-transform: uppercase;
    letter-spacing: var(--ls-wider);
    margin: 0 0 var(--space-lg);
    font-weight: 600;
  }

  .a-difference__relay,
  .a-difference__together {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .a-difference__relay li,
  .a-difference__together li {
    padding: var(--space-md);
    background: var(--paper-raised, var(--paper));
    border: 1px solid var(--rule);
    border-radius: var(--radius-sm);
    font-size: var(--text-base);
  }

  .a-difference__relay li small {
    display: block;
    margin-top: 2px;
    color: var(--ink-soft);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: var(--ls-wide);
  }

  .a-difference__together li {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-md);
  }

  .a-difference__together li b {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--accent);
  }

  .a-difference__note {
    margin: var(--space-md) 0 0;
    font-size: var(--text-sm);
    line-height: var(--lh-generous);
    color: var(--ink-soft);
  }

  .a-difference__pullquote {
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--text-3xl);
    text-align: center;
    max-width: 34ch;
    margin: var(--space-3xl) auto 0;
    line-height: var(--lh-normal);
  }

  @media (max-width: 768px) {
    .a-difference__grid {
      grid-template-columns: 1fr;
    }

    .a-difference__heading {
      font-size: var(--text-4xl);
    }

    .a-difference__pullquote {
      font-size: var(--text-2xl);
    }
  }
</style>

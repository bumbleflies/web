---
interface Props {
  audioId: string;
  audioSrc: string;
  /** Button label in the resting state, e.g. "Audio-Zusammenfassung". */
  playLabel: string;
  /** Button label while playing, e.g. "Wiedergabe pausieren". */
  pauseLabel: string;
  /** 'post' for article pages, 'card' for blog listing cards. */
  variant?: 'post' | 'card';
}

const { audioId, audioSrc, playLabel, pauseLabel, variant = 'post' } = Astro.props;
---

<div class={`audio-toggle audio-toggle--${variant}`}>
  <button
    class="audio-toggle__button"
    type="button"
    aria-label={playLabel}
    title={playLabel}
    data-audio-toggle
    data-audio-target={audioId}
    data-play-label={playLabel}
    data-pause-label={pauseLabel}
  >
    <span>{playLabel}</span>
    <svg class="audio-toggle__icon audio-toggle__icon--play" viewBox="0 0 24 24" aria-hidden="true">
      <path d="M8 5.5v13l10-6.5z" fill="currentColor" />
    </svg>
    <svg class="audio-toggle__icon audio-toggle__icon--pause" viewBox="0 0 24 24" aria-hidden="true">
      <path d="M7 5h3v14H7zm7 0h3v14h-3z" fill="currentColor" />
    </svg>
  </button>
  <audio id={audioId} preload="metadata" src={audioSrc} data-audio-player></audio>
</div>

<script>
  document.querySelectorAll('[data-audio-toggle]').forEach((button) => {
    if (!(button instanceof HTMLButtonElement)) return;
    // Cards render once per post, so this script can run several times on
    // listing pages. Never bind the same button twice.
    if (button.dataset.audioInit === 'true') return;
    button.dataset.audioInit = 'true';

    const audio = document.getElementById(button.dataset.audioTarget ?? '');
    if (!(audio instanceof HTMLAudioElement)) return;

    const playLabel = button.dataset.playLabel ?? button.title;
    const pauseLabel = button.dataset.pauseLabel ?? playLabel;
    const setPlaying = (playing: boolean) => {
      button.dataset.playing = String(playing);
      const label = playing ? pauseLabel : playLabel;
      button.setAttribute('aria-label', label);
      button.setAttribute('title', label);
    };

    button.addEventListener('click', () => {
      if (audio.paused) {
        // Only one recording plays at a time.
        document.querySelectorAll('audio[data-audio-player]').forEach((other) => {
          if (other instanceof HTMLAudioElement && other !== audio && !other.paused) other.pause();
        });
        audio.play();
      } else {
        audio.pause();
      }
    });
    audio.addEventListener('play', () => setPlaying(true));
    audio.addEventListener('pause', () => setPlaying(false));
    audio.addEventListener('ended', () => setPlaying(false));
  });
</script>

<style>
  .audio-toggle--post {
    margin-top: var(--space-lg);
  }

  .audio-toggle__button {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    width: auto;
    min-height: 48px;
    padding: 0 var(--space-md);
    border: 1px solid var(--rule);
    border-radius: var(--radius-full);
    background: transparent;
    color: var(--accent);
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--ls-wider);
    text-transform: uppercase;
    text-align: left;
    transition: border-color var(--duration-fast) var(--easing-default),
      background var(--duration-fast) var(--easing-default), color var(--duration-fast) var(--easing-default);
  }

  .audio-toggle--card .audio-toggle__button {
    display: inline-flex;
    gap: var(--space-sm);
    min-height: 44px;
  }

  .audio-toggle__button:hover,
  .audio-toggle__button:focus-visible {
    border-color: var(--accent);
    background: var(--accent);
    color: var(--bg);
  }

  .audio-toggle__icon {
    width: 18px;
    height: 18px;
  }

  .audio-toggle--card .audio-toggle__icon {
    width: 16px;
    height: 16px;
  }

  .audio-toggle__icon--pause { display: none; }
  .audio-toggle__button[data-playing='true'] .audio-toggle__icon--play { display: none; }
  .audio-toggle__button[data-playing='true'] .audio-toggle__icon--pause { display: block; }
</style>

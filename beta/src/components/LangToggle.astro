---
interface Props {
  lang: 'DE' | 'EN';
  id?: string;
}

const { lang, id = 'lang-toggle' } = Astro.props;
---

<button
  class="bf-lang"
  aria-label={`Switch to ${lang === 'DE' ? 'English' : 'Deutsch'}`}
  title={`Switch to ${lang === 'DE' ? 'English' : 'Deutsch'}`}
>
  <span class="lang-display">{lang === 'DE' ? 'EN' : 'DE'}</span>
</button>

<script>
  const toggle = document.querySelector('.bf-lang');
  if (toggle) {
    toggle.addEventListener('click', () => {
      const path = window.location.pathname;
      const isEnglish = path.startsWith('/en');

      if (isEnglish) {
        // Switch to German
        window.location.href = path.replace(/^\/en/, '') || '/';
      } else {
        // Switch to English
        window.location.href = path === '/' ? '/en/' : '/en' + path;
      }
    });
  }
</script>

<style>
  .bf-lang {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    border: 1px solid var(--rule);
    border-radius: var(--radius-full);
    padding: var(--space-xs) var(--space-sm);
    font-size: var(--text-xs);
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: var(--ls-wide);
    color: var(--ink-soft);
    cursor: pointer;
    transition: all var(--duration-fast);
    min-width: 44px;
    min-height: 44px;
    border: none;
  }

  .bf-lang:hover {
    background: var(--ink-soft);
    color: var(--paper);
  }

  .bf-lang:active {
    opacity: 0.8;
  }

  .lang-display {
    display: block;
  }
</style>

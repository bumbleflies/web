---
type AccentColor = 'coral' | 'blue' | 'teal';

interface Props {
  headline: string;
  subheading?: string;
  buttonText: string;
  buttonHref: string;
  accentColor?: AccentColor;
}

const { headline, subheading, buttonText, buttonHref, accentColor = 'coral' } = Astro.props;

const bgGradients = {
  coral: 'linear-gradient(135deg, #f5e6d3 0%, #ffb8a1 100%)',
  blue: 'linear-gradient(135deg, #d9e4f7 0%, #6d9eeb 100%)',
  teal: 'linear-gradient(135deg, #c8e6e0 0%, #4db8aa 100%)',
};
---

<section class="bf-cta-section" style={`background: ${bgGradients[accentColor]}`}>
  <div class="bf-container">
    <div class="bf-cta-section__content">
      <h2 class="bf-cta-section__headline">{headline}</h2>
      {subheading && (
        <p class="bf-cta-section__subheading">{subheading}</p>
      )}
      <a href={buttonHref} class="bf-cta">{buttonText}</a>
    </div>
  </div>
</section>

<style>
  .bf-cta-section {
    padding: var(--space-5xl) 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .bf-cta-section__content {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: var(--space-2xl);
    max-width: 800px;
  }

  .bf-cta-section__headline {
    font-family: var(--font-display);
    font-size: var(--text-6xl);
    line-height: var(--lh-snug);
    letter-spacing: var(--ls-tight);
    margin: 0;
    font-weight: 400;
    color: var(--ink);
  }

  .bf-cta-section__subheading {
    font-family: var(--font-sans);
    font-size: var(--text-lg);
    line-height: var(--lh-loose);
    color: var(--ink-soft);
    margin: 0;
    max-width: 700px;
  }

  @media (max-width: 768px) {
    .bf-cta-section {
      padding: var(--space-3xl) 0;
    }

    .bf-cta-section__headline {
      font-size: var(--text-4xl);
    }

    .bf-cta-section__subheading {
      font-size: var(--text-base);
    }
  }

  @media (max-width: 480px) {
    .bf-cta-section {
      padding: var(--space-2xl) 0;
    }

    .bf-cta-section__headline {
      font-size: var(--text-2xl);
    }

    .bf-cta-section__subheading {
      font-size: var(--text-sm);
    }

    .bf-cta-section__content {
      gap: var(--space-xl);
    }
  }
</style>

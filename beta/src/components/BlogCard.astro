---
interface Props {
  title: string;
  excerpt: string;
  category: string;
  order: number;
  readingTime?: string;
  slug: string;
  image?: string;
  draft?: boolean;
  lang?: 'DE' | 'EN';
}

import BlogCover from './BlogCover.astro';
import { getBlogAudioPath } from '../lib/blog-audio';

const { title, excerpt, category, order, readingTime, slug, image, draft, lang = 'DE' } = Astro.props;
const partLabel = lang === 'EN' ? `Part ${String(order).padStart(2, '0')}` : `Teil ${String(order).padStart(2, '0')}`;
const blogPath = lang === 'EN' ? `/en/blog/${slug}` : `/blog/${slug}`;
const draftLabel = lang === 'EN' ? 'Preview' : 'Vorschau';
const readLabel = lang === 'EN' ? 'Read' : 'Lesen';
const audioLabel = lang === 'EN' ? 'Audio-Summary' : 'Audio-Zusammenfassung';
const audioSrc = getBlogAudioPath(lang, slug);
---

<article class="a-blog-card" data-draft={draft ? '' : undefined}>
  {image && (
    <a class="a-blog-card__cover" href={blogPath} aria-hidden="true" tabindex="-1">
      <BlogCover image={image} />
    </a>
  )}
  <div class="a-blog-card__meta">
    <span class="a-blog-card__part">{partLabel}</span>
    <span class="a-blog-card__category">{category}</span>
    {draft && <span class="a-blog-card__draft">{draftLabel}</span>}
  </div>
  <h3 class="a-blog-card__title">
    <a href={blogPath}>{title}</a>
  </h3>
  <p class="a-blog-card__excerpt">{excerpt}</p>
  <div class="a-blog-card__footer">
    <div class="a-blog-card__actions">
      <a href={blogPath} class="bf-cta">
        {readLabel} <span aria-hidden="true">→</span>
      </a>
      {audioSrc && (
        <>
          <button
            class="a-blog-card__audio-toggle"
            type="button"
            aria-label={audioLabel}
            title={audioLabel}
            data-blog-card-audio-toggle
            data-audio-target={`audio-card-${lang}-${slug}`}
          >
            <span>{audioLabel}</span>
            <svg class="a-blog-card__audio-icon a-blog-card__audio-icon--play" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M8 5.5v13l10-6.5z" fill="currentColor" />
            </svg>
            <svg class="a-blog-card__audio-icon a-blog-card__audio-icon--pause" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M7 5h3v14H7zm7 0h3v14h-3z" fill="currentColor" />
            </svg>
          </button>
          <audio id={`audio-card-${lang}-${slug}`} preload="metadata" src={audioSrc}></audio>
        </>
      )}
    </div>
    {readingTime && <span class="a-blog-card__time">{readingTime}</span>}
  </div>
</article>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-blog-card-audio-toggle]').forEach((button) => {
    const audio = document.getElementById(button.dataset.audioTarget ?? '') as HTMLAudioElement | null;
    if (!audio) return;

    const setPlaying = (playing: boolean) => {
      button.dataset.playing = String(playing);
      button.setAttribute('aria-label', playing ? 'Pause playback' : button.title);
    };

    button.addEventListener('click', () => {
      if (audio.paused) audio.play();
      else audio.pause();
    });
    audio.addEventListener('play', () => setPlaying(true));
    audio.addEventListener('pause', () => setPlaying(false));
    audio.addEventListener('ended', () => setPlaying(false));
  });
</script>

<style>
  .a-blog-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    padding: var(--space-xl);
    background: var(--paper);
    border: 1px solid var(--rule);
    border-radius: var(--radius-sm);
    border-left: 4px solid var(--accent);
    min-height: 100%;
    transition: transform var(--duration-fast) var(--easing-default), border-color var(--duration-fast) var(--easing-default);
  }

  .a-blog-card:hover {
    transform: translateY(-4px);
    border-color: var(--accent);
  }

  /* Full-bleed cover: pull to the card's padding-box edges, round the top corners. */
  .a-blog-card__cover {
    display: block;
    margin: calc(-1 * var(--space-xl)) calc(-1 * var(--space-xl)) 0;
    border-radius: var(--radius-sm) var(--radius-sm) 0 0;
    overflow: hidden;
  }

  .a-blog-card__meta {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: var(--ls-wider);
  }

  .a-blog-card__part {
    color: var(--accent);
  }

  .a-blog-card__category {
    color: var(--ink-soft);
  }

  .a-blog-card__draft {
    margin-left: auto;
    padding: 2px 8px;
    border: 1px solid var(--accent);
    border-radius: var(--radius-full);
    color: var(--accent);
    letter-spacing: var(--ls-wide);
  }

  .a-blog-card__title {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    line-height: var(--lh-snug);
    margin: 0;
    color: var(--ink);
  }

  .a-blog-card__title a {
    color: inherit;
    text-decoration: none;
  }

  .a-blog-card__title a:hover {
    color: var(--accent);
  }

  .a-blog-card__excerpt {
    color: var(--ink-soft);
    margin: 0;
    flex-grow: 1;
    line-height: var(--lh-body);
  }

  .a-blog-card__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    margin-top: var(--space-sm);
  }

  .a-blog-card__actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }

  .a-blog-card__audio-toggle {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    min-height: 44px;
    padding: 0 var(--space-md);
    border: 1px solid var(--rule);
    border-radius: var(--radius-full);
    background: transparent;
    color: var(--accent);
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--ls-wider);
    text-transform: uppercase;
    transition: border-color var(--duration-fast) var(--easing-default),
      background var(--duration-fast) var(--easing-default), color var(--duration-fast) var(--easing-default);
  }

  .a-blog-card__audio-toggle:hover,
  .a-blog-card__audio-toggle:focus-visible {
    border-color: var(--accent);
    background: var(--accent);
    color: var(--bg);
  }

  .a-blog-card__audio-icon {
    width: 16px;
    height: 16px;
  }

  .a-blog-card__audio-icon--pause { display: none; }
  .a-blog-card__audio-toggle[data-playing='true'] .a-blog-card__audio-icon--play { display: none; }
  .a-blog-card__audio-toggle[data-playing='true'] .a-blog-card__audio-icon--pause { display: block; }

  .a-blog-card__time {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--ink-soft);
  }
</style>

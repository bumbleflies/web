{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "packageRules": [
    {
      "description": "TypeScript 7.1+ is required by @astrojs/ts-content-mapper; skip nightly dev builds and hold the 7.1 line",
      "matchPackageNames": ["typescript"],
      "allowedVersions": "/^7\\.1\\.\\d+(?:-beta)?$/"
    },
    {
      "description": "Automerge non-major updates",
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "automerge": true,
      "semanticCommitType": "fix"
    },
    {
      "description": "Automerge dev dependencies",
      "matchDepTypes": [
        "devDependencies"
      ],
      "automerge": true,
      "semanticCommitType": "fix"
    },
    {
      "description": "Automerge GitHub Actions",
      "matchManagers": ["github-actions"],
      "automerge": true,
      "semanticCommitType": "fix"
    }
  ]
}

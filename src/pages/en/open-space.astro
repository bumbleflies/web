---
import Layout from '../../components/Layout.astro';
import Nav from '../../components/Nav.astro';
import OpenSpaceOffer from '../../components/OpenSpaceOffer.astro';
import PrincipleSequence from '../../components/PrincipleSequence.astro';
import CTAStrip from '../../components/CTAStrip.astro';
import Footer from '../../components/Footer.astro';
import { getCollection } from 'astro:content';

const pageContent = await getCollection('pages', ({ id }) => id === 'en/open-space');
const page = pageContent[0];

if (!page) {
  throw new Error('EN Open Space principles content not found in collection');
}

const principles = page.data.principles ?? [];
const currentLang: 'DE' | 'EN' = 'EN';

const copy = {
  eyebrow: 'Open Space facilitation',
  h1: 'Open Space facilitation for 8 to 500 people',
  lead: 'An Open Space is not an event, it is a decision: one question that actually matters, a marketplace of the participants’ own topics, sessions where the work happens. We sharpen the question with you, facilitate the day, and document the decisions with named owners. Remote, hybrid or on site.',
  facts: ['8–500 participants', 'Munich & DACH', 'Remote, hybrid or on site', 'German and English'],
  primaryCta: 'Book a first conversation',
  secondaryCta: 'See the formats',
  formatsHeading: 'Formats',
  formats: [
    {
      title: 'Open Space conference',
      body: 'One question for the whole organization: marketplace, parallel sessions, outcomes that outlive the day.',
      meta: 'Large group · on site',
    },
    {
      title: 'Open Space day for a team or unit',
      body: 'Smaller group, same logic: settle priorities, make decisions with named owners, agree the next steps.',
      meta: 'Team or unit',
    },
    {
      title: 'Online Open Space',
      body: 'A distributed team with the same effect: sessions in breakouts, a digital marketplace, outcomes documented live.',
      meta: 'Remote or hybrid',
    },
  ],
  referencesHeading: 'References',
  references: [
    {
      company: 'Siemens AG',
      outcome: 'Enterprise team alignment, May 2023: clear decisions with named owners, follow-up sessions booked.',
      href: '/case-studies/siemens/',
    },
    {
      company: 'Wohnungshelden',
      outcome: 'Annual Open Space as the year-end retrospective: clarity on priorities, ongoing collaboration.',
      href: '/case-studies/wohnungshelden/',
    },
    {
      company: 'Dialograum Geld',
      outcome: 'An Open Space on a taboo topic: sensitive conversations facilitated, voices heard, taboo normalized.',
      href: '/case-studies/dialograum-geld/',
    },
  ],
  processHeading: 'How an Open Space works with us',
  steps: [
    {
      title: 'Sharpen the question',
      body: 'No good Open Space without a good question. We work on it with you until it is genuinely open.',
    },
    {
      title: 'Invite',
      body: 'Who sits in the room co-decides the outcome. We help define the group.',
    },
    {
      title: 'Marketplace & sessions',
      body: 'The participants set the topics, the law of mobility applies. We facilitate, document and hold the frame.',
    },
    {
      title: 'Record the decisions',
      body: 'Outcomes, decisions and the people responsible are written down — otherwise it was just an event.',
    },
  ],
};
---

<Layout
  title="Open Space facilitation in Munich: bumbleflies"
  description="Open Space facilitation for 8 to 500 people: sharpen the question, facilitate the marketplace, document decisions with owners. Remote, hybrid or on site."
  canonical="https://bumbleflies.de/en/open-space"
  lang={currentLang}
  dePath="/open-space"
  enPath="/en/open-space"
>
  <Nav slot="nav" lang={currentLang} />

  <OpenSpaceOffer copy={copy} />

  <section class="os-principles bf-section">
    <div class="bf-container">
      <h2 class="os-principles__heading">The principles behind it</h2>
      <p class="os-principles__lead">
        {page.data.heading} — and the law of mobility. That is the method behind every Open Space
        bumbleflies facilitates.
      </p>
    </div>
    <PrincipleSequence principles={principles} exitHref="#open-space-end" lang={currentLang} />
  </section>

  <div id="open-space-end">
    <CTAStrip
      heading="Ready for"
      headingEm="your Open Space?"
      body="Send us two sentences. We respond within 24h with the proposal that fits."
      ctaText="Book a first call"
      lang={currentLang}
    />
  </div>

  <Footer slot="footer" lang={currentLang} />
</Layout>

<style>
  .os-principles {
    padding-bottom: 0;
  }

  .os-principles__heading {
    font-size: var(--text-4xl);
    letter-spacing: -0.02em;
    margin-bottom: var(--space-md);
  }

  .os-principles__lead {
    font-size: var(--text-lg);
    line-height: var(--lh-generous);
    color: var(--ink-soft);
    max-width: 62ch;
    margin-bottom: var(--space-xl);
  }
</style>
